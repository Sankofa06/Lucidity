<?xml version="1.0" encoding="UTF-8"?>
<!-- Fleet/deploy/macos/com.lucidity.orchestrator.plist
     launchd unit template: the fleet orchestrator (Mac Mini only).
     __PLACEHOLDERS__ are substituted by install.sh. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.lucidity.orchestrator</string>
    <key>ProgramArguments</key>
    <array>
        <string>__NODE__</string>
        <string>__REPO__/Fleet/orchestrator/dist/index.js</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__REPO__/Fleet</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/lucidity/orchestrator.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/lucidity/orchestrator.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>FLEET_CONFIG</key>
        <string>__REPO__/LocalDev/fleet.local.json</string>
    </dict>
</dict>
</plist>
